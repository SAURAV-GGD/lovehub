# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL - Neon / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/lovehub

# Authentication (better-auth)
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_here
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Provider Configuration (Server-Side Only)
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Payments - YouPI-PG Gateway & Direct NPCI UPI
# Self-hosted internal portal URL: https://www.lovehub.in
YOUPI_API_URL=https://www.lovehub.in
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret_here
YOUPI_CHECKOUT_URL=https://www.lovehub.in/pay
UPI_VPA=paytm.s1kx5cu@pty
UPI_MERCHANT_NAME=Lovehub By Saurav

# Object Storage — Supabase Storage (Preferred Free Cloud CDN & Bucket)
# Obtain from Supabase Project Settings > API & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=proposal-photos

# Object Storage — Cloudflare R2 (User Pictures & Media)
# Obtain from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lovehub-media
# Public CDN URL (either custom domain e.g. https://images.lovehub.in or R2 dev url https://pub-xxxxxx.r2.dev)
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# Image Storage — ImgBB API (Free Unlimited Image Hosting, No Credit Card Required)
IMGBB_API_KEY=your_imgbb_api_key_here

# Image Storage — Cloudinary (Server-Side Only - Private, No Credit Card Required)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

